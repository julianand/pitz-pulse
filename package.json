{
  "name": "pitz-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pitz Pulse — triage inteligente de solicitudes internas (case técnico Pitz)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "llm:ping": "tsx scripts/ping-llm.ts",
    "smoke": "tsx scripts/smoke-api.ts",
    "results": "tsx scripts/generate-results.ts",
    "eval": "tsx scripts/eval.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "openai": "^7.35.0",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^5.0.5"
  }
}
