{
  // Config SOLO para el editor y para chequear tipos de `tests/`.
  // No interviene en el build: `npm run build` usa el tsconfig.json raíz,
  // que excluye `tests/` (Vitest transpila con esbuild, sin chequear tipos).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".."
  },
  "include": ["./**/*.ts"],
  "exclude": ["../node_modules", "../dist"]
}
