# ----------------------------------------------------------------------------
# Pitz Pulse — variables de entorno (NO incluir valores reales aquí)
# Copiar a .env y completar:  cp .env.example .env
# ----------------------------------------------------------------------------

# Servidor
NODE_ENV=development
PORT=3000
# Nivel de logs del logger estructurado (pino): trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Build del frontend que sirve Express (relativo al cwd). Vacío = no sirve estáticos.
# `npm run build:web` genera `web/dist`. La API key del frontend vive en `web/.env` (VITE_API_KEY).
WEB_DIST=web/dist

# Autenticación del servicio (API key enviada en el header del request)
API_KEY=change-me

# Base de datos (SQLite + Prisma). La ruta es relativa al schema de Prisma.
DATABASE_URL=file:./dev.db

# Proveedor LLM (endpoint OpenAI-compatible)
LLM_PROVIDER_BASE_URL=https://api.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3
# Reasoning del proveedor. Valores válidos: none|minimal|low|medium|high|xhigh|max.
# ⚠️ En opencode-go el reasoning viene ACTIVADO por defecto: para DESACTIVARLO usar `none`.
#    `off` o vacío NO lo desactiva (se omite el parámetro y rige el default) → ~7s vs ~2s.
LLM_REASONING_EFFORT=none
# Valor por defecto del header x-opencode-session (opencode-go). En el flujo real se envía el id
# de la solicitud; esto es solo el fallback si el request no trae id.
LLM_SESSION_ID=pitz-pulse

# Prompt / clasificación
PROMPT_VERSION=v2
CONFIDENCE_THRESHOLD=0.75

# Concurrencia del batch
CONCURRENCY_LIMIT=4

# Precios por modelo (USD por 1M tokens; usados para estimar el costo de cada llamada).
# Valores de ejemplo (deepseek-v4.1-flash) para reproducir los costos del README/DECISIONES.
PRICE_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.60

# Modo mock (1 = no llama a la API real del modelo; usado por tests)
MOCK=0
