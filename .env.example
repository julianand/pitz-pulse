# ----------------------------------------------------------------------------
# Pitz Pulse — variables de entorno (NO incluir valores reales aquí)
# Copiar a .env y completar:  cp .env.example .env
# ----------------------------------------------------------------------------

# Servidor
NODE_ENV=development
PORT=3000

# Autenticación del servicio (API key enviada en el header del request)
API_KEY=change-me

# Base de datos (SQLite + Prisma). La ruta es relativa al schema de Prisma.
DATABASE_URL=file:./dev.db

# Proveedor LLM (endpoint OpenAI-compatible)
LLM_PROVIDER_BASE_URL=https://api.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3
LLM_REASONING_EFFORT=off

# Prompt / clasificación
PROMPT_VERSION=v1
CONFIDENCE_THRESHOLD=0.75

# Concurrencia del batch
CONCURRENCY_LIMIT=4

# Precios por modelo (USD por 1M tokens; usados para estimar costo)
PRICE_INPUT_PER_1M=0
PRICE_OUTPUT_PER_1M=0

# Modo mock (1 = no llama a la API real del modelo; usado por tests)
MOCK=0
