# ----------------------------------------------------------------------------
# Pitz Pulse — frontend (Vite). Copiar a `web/.env` (no se versiona).
# OPCIONAL: si no existe, la UI usa el default `dev-api-key`, el mismo que el
# backend, y funciona igual (salvo que quieras una key distinta a la default).
# ----------------------------------------------------------------------------
# API key que exige el backend (header `x-api-key`).
# ⚠️ Debe ser la MISMA que `API_KEY` del `.env` de la raíz, o la API responde 401.
# ⚠️ Se inyecta en el bundle: cualquiera que abra la UI puede leerla (es inevitable en una web);
#    para este case es aceptable.
VITE_API_KEY=dev-api-key

# Base de la API. Vacío = mismo origen (recomendado; evita CORS).
# Solo hace falta si servís la UI desde otro host.
VITE_API_BASE_URL=

# Target del proxy de dev (Vite → Express).
VITE_PROXY_TARGET=http://localhost:3000
